{
  "name": "@cyberclaw/agent-core",
  "version": "0.1.0",
  "description": "CyberClaw 智能体核心包：Agent 最小可运行循环（systemPrompt + model + tools）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
